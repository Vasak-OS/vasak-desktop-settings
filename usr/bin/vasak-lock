#!/usr/bin/env python3
# VasakOS screen lock: gtklock, dressed with the configuration in use.
#
# gtklock reads its stylesheet and its background once, from the command line,
# and never looks at them again. So the theming has to happen at the moment of
# locking: this renders /usr/share/vasak/gtklock.css.in with the colours, the
# corner radius and the font from ~/.config/vasak/vasak.conf — the same file
# and the same scheme the apps read — blurs the current wallpaper, and hands
# both to gtklock. Extra arguments are forwarded (the idle unit passes -d for
# the before-sleep lock).
#
# Nothing here may keep the screen from locking: every step is optional and
# falls back to plain gtklock if it fails.

import hashlib
import json
import os
import re
import sys
from pathlib import Path

GTKLOCK = "/usr/bin/gtklock"

TEMPLATE_NAME = "gtklock.css.in"
SYSTEM_TEMPLATE = Path("/usr/share/vasak") / TEMPLATE_NAME

# Same fallback the desktop uses when nobody has chosen a wallpaper yet.
DEFAULT_WALLPAPER = "/usr/share/backgrounds/cutefishos/wallpaper-9.jpg"

# How much of the theme background is mixed into the wallpaper. Enough that the
# text colours of the scheme stay readable over any photo, little enough that
# the wallpaper is still recognisable. Light mode needs more of it: dark text
# over a dark photograph is the combination that stops being legible first.
TINT_ALPHA = {"light": 0.6, "dark": 0.45}
# The blurred image is stretched back to the whole screen by gtklock, so it is
# rendered small: cheap to produce and impossible to tell apart once blurred.
BLUR_DOWNSCALE = 20
MAX_BLUR_WIDTH = 1600
# Bumped when the blur itself changes, so cached backgrounds are regenerated.
BACKGROUND_VERSION = 1

# Status colours are not part of a scheme; these are the values in the apps'
# style.css, kept in sync by hand.
STATUS_COLORS = {
    "light": {"status-error": "#d20f39", "status-warning": "#df8e1d"},
    "dark": {"status-error": "#f38ba8", "status-warning": "#f9e2af"},
}

# Used only when the configuration or the scheme cannot be read at all.
FALLBACK_COLORS = {
    "light": {
        "primary": "#dd7878",
        "secondary": "#8839ef",
        "background": "#eff1f5",
        "surface": "#ccd0da",
        "border": "#dce0e8",
        "text-main": "#4c4f69",
        "text-muted": "#6c6f85",
        "text-on-primary": "#5c5f77",
    },
    "dark": {
        "primary": "#eba0ac",
        "secondary": "#cba6f7",
        "background": "#1e1e2e",
        "surface": "#313244",
        "border": "#11111b",
        "text-main": "#cdd6f4",
        "text-muted": "#a6adc8",
        "text-on-primary": "#cdd6f4",
    },
}

DEFAULT_RADIUS = 10


def warn(message):
    print("vasak-lock: %s" % message, file=sys.stderr)


def home():
    return Path(os.environ.get("HOME") or Path.home())


def config_path():
    """Same lookup as tauri-plugin-config-manager, env override included."""
    from_env = os.environ.get("VASAK_CONFIG_PATH")
    if from_env:
        return Path(from_env)
    return home() / ".config/vasak/vasak.conf"


def scheme_dirs():
    from_env = os.environ.get("VASAK_SCHEMES_PATHS")
    if from_env:
        return [Path(entry) for entry in from_env.split(os.pathsep) if entry]
    return [home() / ".config/vasak/schemes", Path("/usr/share/schemes")]


def load_config():
    try:
        with open(config_path(), encoding="utf-8") as handle:
            return json.load(handle)
    except Exception as error:
        warn("using the default theme, the configuration could not be read: %s" % error)
        return {}


def load_scheme(scheme_id):
    """First scheme whose id matches, in the order the apps search."""
    for directory in scheme_dirs():
        try:
            entries = sorted(directory.glob("*.json"))
        except Exception:
            continue

        for entry in entries:
            try:
                with open(entry, encoding="utf-8") as handle:
                    data = json.load(handle)
            except Exception:
                continue

            if data.get("id") == scheme_id:
                return data

    return None


def build_palette(config):
    style = config.get("style")
    if not isinstance(style, dict):
        style = {}
    variant = "dark" if style.get("darkmode") else "light"

    colors = dict(FALLBACK_COLORS[variant])
    scheme = load_scheme(style.get("color-scheme") or "vasak-default")

    if scheme is None:
        warn("scheme '%s' not found, falling back to the Vasak colours"
             % (style.get("color-scheme") or "vasak-default"))
    else:
        try:
            ui = scheme["colors"][variant]["ui"]
            colors.update(
                {
                    "primary": ui["color"]["primary"],
                    "secondary": ui["color"]["secondary"],
                    "background": ui["background"],
                    "surface": ui["surface"],
                    "border": ui["border"],
                    "text-main": ui["text"]["main"],
                    "text-muted": ui["text"]["muted"],
                    "text-on-primary": ui["text"]["on-primary"],
                }
            )
        except (KeyError, TypeError) as error:
            warn("scheme is missing colours, completing it with the defaults: %s" % error)

    colors.update(STATUS_COLORS[variant])

    radius = style.get("radius")
    if not isinstance(radius, int) or radius < 0:
        radius = DEFAULT_RADIUS

    fonts = config.get("fonts")
    font = (fonts.get("apps") or "").strip() if isinstance(fonts, dict) else ""

    return {
        "variant": variant,
        "colors": colors,
        "radius": radius,
        "font": font,
    }


def parse_hex(value):
    text = value.strip().lstrip("#")
    if len(text) == 3:
        text = "".join(character * 2 for character in text)
    if len(text) != 6:
        raise ValueError("not a colour: %s" % value)
    return tuple(int(text[index:index + 2], 16) for index in (0, 2, 4))


def template_path():
    user_template = home() / ".config/vasak" / TEMPLATE_NAME
    if user_template.is_file():
        return user_template
    if SYSTEM_TEMPLATE.is_file():
        return SYSTEM_TEMPLATE
    return None


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    directory = Path(base) / "vasak" if base else cache_dir()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    return directory


def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or (home() / ".cache")
    directory = Path(base) / "vasak"
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def render_css(palette):
    """Substitutes the template tokens and returns the path to feed gtklock."""
    source = template_path()
    if source is None:
        warn("no %s found, locking with the gtklock defaults" % TEMPLATE_NAME)
        return None

    colors = palette["colors"]
    values = {
        "radius": "%dpx" % palette["radius"],
        "radius-window": "%dpx" % (palette["radius"] + 2),
        "font-declaration": 'font-family: "%s";' % palette["font"] if palette["font"] else "",
    }

    def resolve(match):
        name, alpha = match.group(1), match.group(2)

        if name in values:
            return values[name]

        if name not in colors:
            warn("unknown token {{%s}} in the template" % name)
            return match.group(0)

        if alpha is None:
            return colors[name]

        red, green, blue = parse_hex(colors[name])
        return "rgba(%d, %d, %d, %s)" % (red, green, blue, int(alpha) / 100)

    css = re.sub(
        r"\{\{([a-z-]+)(?:/(\d{1,3}))?\}\}",
        resolve,
        source.read_text(encoding="utf-8"),
    )

    destination = runtime_dir() / "gtklock.css"
    temporary = destination.with_name("%s.%d.new" % (destination.name, os.getpid()))
    temporary.write_text(css, encoding="utf-8")
    temporary.replace(destination)
    return str(destination)


def wallpaper_path(config):
    desktop = config.get("desktop")
    wallpapers = (desktop.get("wallpaper") or []) if isinstance(desktop, dict) else []
    for entry in wallpapers[:1]:
        if isinstance(entry, str) and entry:
            path = entry[7:] if entry.startswith("file://") else entry
            if Path(path).is_file():
                return path
    return DEFAULT_WALLPAPER


def screen_size():
    """Screen geometry, because gtklock stretches the background to fill it."""
    try:
        import gi

        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk

        display = Gdk.Display.open(None) or Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        geometry = monitor.get_geometry()
        if geometry.width > 0 and geometry.height > 0:
            return geometry.width, geometry.height
    except Exception:
        pass

    return 1920, 1080


def blur_target(width, height):
    if width <= MAX_BLUR_WIDTH:
        return width, height
    return MAX_BLUR_WIDTH, max(1, round(height * MAX_BLUR_WIDTH / width))


def rescale(pixbuf, width, height, GdkPixbuf):
    """Resizes by halving or doubling first.

    One bilinear jump between very different sizes leaves the blur full of
    facets and diamonds; stepping by a factor of two averages every pixel on
    the way down and interpolates smoothly on the way up, for the same handful
    of milliseconds.
    """
    current = pixbuf

    while current.get_width() // 2 > width and current.get_height() // 2 > height:
        current = current.scale_simple(
            current.get_width() // 2,
            current.get_height() // 2,
            GdkPixbuf.InterpType.BILINEAR,
        )

    while current.get_width() * 2 < width and current.get_height() * 2 < height:
        current = current.scale_simple(
            current.get_width() * 2,
            current.get_height() * 2,
            GdkPixbuf.InterpType.BILINEAR,
        )

    if current.get_width() == width and current.get_height() == height:
        return current.copy() if current is pixbuf else current

    return current.scale_simple(width, height, GdkPixbuf.InterpType.BILINEAR)


def prepare_background(config, palette):
    """Blurs and tints the wallpaper, caching the result until it changes."""
    import gi

    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf

    source = wallpaper_path(config)
    stat = os.stat(source)
    tint = palette["colors"]["background"]
    alpha = TINT_ALPHA[palette["variant"]]
    width, height = blur_target(*screen_size())

    key = hashlib.sha256(
        "|".join(
            str(part)
            for part in (
                BACKGROUND_VERSION,
                source,
                stat.st_mtime_ns,
                stat.st_size,
                width,
                height,
                tint,
                alpha,
                BLUR_DOWNSCALE,
            )
        ).encode("utf-8")
    ).hexdigest()[:16]

    destination = cache_dir() / ("lock-background-%s.png" % key)
    if destination.is_file():
        return str(destination)

    pixbuf = GdkPixbuf.Pixbuf.new_from_file(source)

    # Cover: crop the middle to the screen proportions instead of squashing the
    # photo, since gtklock stretches whatever it gets to 100% of the output.
    crop_width = min(pixbuf.get_width(), round(pixbuf.get_height() * width / height))
    crop_height = min(pixbuf.get_height(), round(pixbuf.get_width() * height / width))
    pixbuf = pixbuf.new_subpixbuf(
        (pixbuf.get_width() - crop_width) // 2,
        (pixbuf.get_height() - crop_height) // 2,
        crop_width,
        crop_height,
    )

    # Blur by scaling down and back up: gdk-pixbuf averages on the way down, so
    # the round trip costs a few milliseconds and needs no image library.
    small = rescale(
        pixbuf,
        max(1, width // BLUR_DOWNSCALE),
        max(1, height // BLUR_DOWNSCALE),
        GdkPixbuf,
    )
    blurred = rescale(small, width, height, GdkPixbuf)

    # A wash of the theme background: it ties the lock screen to the palette and
    # guarantees the scheme's text colours stay readable over any wallpaper.
    red, green, blue = parse_hex(tint)
    overlay = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8, width, height)
    overlay.fill((red << 24) | (green << 16) | (blue << 8) | 0xFF)
    overlay.composite(
        blurred, 0, 0, width, height, 0, 0, 1, 1,
        GdkPixbuf.InterpType.NEAREST,
        int(alpha * 255),
    )

    temporary = destination.with_name("%s.%d.new" % (destination.name, os.getpid()))
    blurred.savev(str(temporary), "png", [], [])
    temporary.replace(destination)

    # Only the current wallpaper is worth keeping around.
    for stale in cache_dir().glob("lock-background-*.png"):
        if stale != destination:
            try:
                stale.unlink()
            except OSError:
                pass

    return str(destination)


def main():
    arguments = []
    config = load_config()

    try:
        palette = build_palette(config)
    except Exception as error:
        warn("locking with the default colours: %s" % error)
        palette = {"colors": dict(FALLBACK_COLORS["dark"], **STATUS_COLORS["dark"]),
                   "radius": DEFAULT_RADIUS, "font": "", "variant": "dark"}

    try:
        style = render_css(palette)
        if style:
            arguments += ["-s", style]
    except Exception as error:
        warn("locking without the Vasak style: %s" % error)

    try:
        background = prepare_background(config, palette)
        if background:
            arguments += ["-b", background]
    except Exception as error:
        warn("locking without a wallpaper: %s" % error)

    arguments += sys.argv[1:]

    try:
        os.execv(GTKLOCK, [GTKLOCK] + arguments)
    except OSError as error:
        warn("could not run %s: %s" % (GTKLOCK, error))
        return 1


if __name__ == "__main__":
    sys.exit(main() or 0)
