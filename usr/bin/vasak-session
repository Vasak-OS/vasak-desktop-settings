#!/bin/bash

export XDG_CURRENT_DESKTOP=Vasak
export DESKTOP_SESSION=vasak
export XDG_SESSION_DESKTOP=vasak
export XDG_SESSION_TYPE=wayland

# The keyboard the installer was told about. Wayfire's default for xkb_layout is
# a hardcoded `us`, so without this the desktop types in US no matter what was
# chosen during the installation or with localectl afterwards; the shipped
# wayfire.ini leaves xkb_layout empty precisely so libxkbcommon falls back to
# these. A layout written in wayfire.ini still wins over them.
if [ -r /etc/vconsole.conf ]; then
    while IFS='=' read -r key value; do
        value=${value%\"}
        value=${value#\"}
        [ -n "$value" ] || continue
        case "$key" in
            XKBLAYOUT) export XKB_DEFAULT_LAYOUT="$value" ;;
            XKBVARIANT) export XKB_DEFAULT_VARIANT="$value" ;;
            XKBMODEL) export XKB_DEFAULT_MODEL="$value" ;;
            XKBOPTIONS) export XKB_DEFAULT_OPTIONS="$value" ;;
        esac
    done < /etc/vconsole.conf
fi

# Wayland/GTK stack used by Tauri 2 and other native Linux apps.
export QT_QPA_PLATFORM='wayland;xcb'
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_ENABLE_HIGHDPI_SCALING=1
export GDK_BACKEND=wayland,x11
export MOZ_ENABLE_WAYLAND=1

# Electron/Chromium compatibility, kept as fallback for XWayland-capable apps.
export ELECTRON_OZONE_PLATFORM_HINT=auto
export OZONE_PLATFORM_HINT=auto
export NIXOS_OZONE_WL=1

# Extra desktop integrations.
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# El agente de claves SSH. Sin esto cada `git push` vuelve a pedir la frase de
# la clave, porque no hay ningún agente y ssh no tiene dónde dejarla: el socket
# lo levanta systemd (ssh-agent.socket) y la variable es la única forma de que
# ssh lo encuentre. La clave se agrega sola la primera vez que se usa, por el
# AddKeysToAgent que va en /etc/ssh/ssh_config.d/.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
systemctl --user enable --now ssh-agent.socket >/dev/null 2>&1 || true

# Y quién pregunta la frase: vasak-ssh-askpass la busca primero en el llavero,
# que el inicio de sesión ya abrió, así que después de escribirla una vez no se
# vuelve a preguntar. «prefer» hace que pregunte con el diálogo del sistema aun
# cuando haya una terminal a mano, que es lo que corresponde en un escritorio.
if [ -x /usr/bin/vasak-ssh-askpass ]; then
    export SSH_ASKPASS=/usr/bin/vasak-ssh-askpass
    export SSH_ASKPASS_REQUIRE=prefer
fi

# Launch Wayfire under uwsm so the whole graphical session is a proper systemd
# user unit hierarchy: correct environment propagation (via `uwsm finalize` in
# wayfire.ini), supervised graphical-session daemons, and clean teardown at
# logout. NOTE: verify the flags against the installed uwsm version.
exec uwsm start -D Vasak wayfire