# Bloqueo por inactividad. Reemplaza al swayidle que antes se lanzaba desde
# [autostart] en wayfire.ini: los demonios de la sesión los administra systemd.
#
# vasak-settings escribe una versión propia en ~/.config/systemd/user/ cuando el
# usuario cambia los tiempos; las unidades de usuario tienen precedencia sobre
# esta, así que los cambios no se pisan al actualizar el paquete.
#
# El bloqueo es vasak-lock-screen, la misma interfaz que la pantalla de inicio:
# lee los colores, el radio y la tipografía de la configuración, y muestra tu
# fondo de escritorio. Reemplaza a gtklock, que se dibujaba con el tema GTK y no
# con el del sistema.
#
# Antes de suspender va con -d, que devuelve el control apenas la pantalla quedó
# cubierta; sin eso swayidle espera a que alguien desbloquee y la suspensión
# nunca llega.
#
# El proceso se lanza en su propio ámbito con systemd-run: de otro modo vive
# dentro del cgroup de esta unidad, y reiniciarla —cosa que hace Configuración
# cada vez que se guarda la página de Energía— mataría un bloqueo activo. Un
# cliente de bloqueo que muere con la sesión tomada deja al compositor
# bloqueado y sin nada donde escribir la contraseña.
[Unit]
Description=Bloqueo por inactividad de VasakOS (swayidle)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# El primer timeout es para el fondo en movimiento: un video decodificando
# detrás de la pantalla de bloqueo, durante horas, es el gasto más inútil que
# tiene el escritorio, y desde adentro del webview no hay forma de saber que
# nadie lo está mirando. Se pausa un rato antes de bloquear y se reanuda al
# volver. Si el fondo es una imagen, los avisos no le hacen nada a nadie.
ExecStart=/usr/bin/swayidle -w \
    timeout 240 'dbus-send --session --dest=org.vasak.os.Desktop --type=method_call /org/vasak/os/Desktop org.vasak.os.Desktop.PauseWallpaper' \
    resume 'dbus-send --session --dest=org.vasak.os.Desktop --type=method_call /org/vasak/os/Desktop org.vasak.os.Desktop.ResumeWallpaper' \
    timeout 300 'systemd-run --user --scope --collect --quiet /usr/bin/vasak-lock-screen' \
    before-sleep 'systemd-run --user --scope --collect --quiet /usr/bin/vasak-lock-screen -d'
Restart=on-failure

# ⚠ Esta unidad va SIN endurecer, y no es un olvido: se intentó y rompió la
# pantalla de bloqueo. Si vas a agregar directivas acá, leé esto antes.
#
# El bloqueo se lanza con `systemd-run --scope`, que cambia el cgroup pero deja
# al proceso como hijo de swayidle. O sea que `vasak-lock-screen` hereda todo lo
# que se le ponga a esta unidad — y lo hereda de dos formas distintas:
#
#   1. Los espacios de nombres. `PrivateDevices` le tapa /dev/dri y el bloqueo
#      no tiene con qué dibujar.
#
#   2. **Los privilegios**, que es lo que no se vio venir. `NoNewPrivileges=yes`
#      se hereda y no se puede soltar, y `pam_unix` valida la contraseña
#      ejecutando /usr/bin/unix_chkpwd, que es setuid/setgid porque necesita
#      leer /etc/shadow. Sin poder escalar, el helper responde «user unknown»,
#      PAM devuelve Authinfo_Unavail (9) y el bloqueo dice que la contraseña
#      está mal **con la contraseña correcta**. Un `CapabilityBoundingSet=`
#      vacío hace lo mismo por otro camino.
#
# Y no alcanza con no escribir `NoNewPrivileges`: en una unidad de usuario lo
# implican solas casi todas las de seccomp —SystemCallFilter,
# RestrictAddressFamilies, RestrictNamespaces, MemoryDenyWriteExecute,
# LockPersonality, RestrictRealtime, RestrictSUIDSGID—. Así que el
# endurecimiento y esta forma de lanzar el bloqueo son incompatibles, y entre
# las dos cosas gana poder entrar a tu sesión.
#
# Si algún día se quiere endurecer esto, primero hay que lanzar el bloqueo de
# manera que no herede: un servicio transitorio (`systemd-run --user --unit=…`,
# sin `--scope`) lo arranca el gestor del usuario y no como hijo de acá.

[Install]
WantedBy=graphical-session.target
