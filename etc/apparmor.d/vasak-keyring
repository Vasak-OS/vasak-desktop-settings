# Perfil de AppArmor del llavero de VasakOS.
#
# ── Por qué está en modo `complain` ─────────────────────────────────────────
#
# `flags=(complain)` significa: registrar todo lo que *se bloquearía*, y no
# bloquear nada. Es a propósito y no es un paso a medias.
#
# Un perfil de AppArmor sólo se puede escribir bien mirando lo que el programa
# pide de verdad, y eso no se adivina leyendo el código: hay bibliotecas,
# locales, /proc y /sys de por medio. El camino previsto por AppArmor es
# arrancar en `complain`, dejar que el programa se use un tiempo, y apretar el
# perfil con `aa-logprof` a partir de lo que quedó en el registro.
#
# Además hay una razón concreta: un perfil equivocado rompe la aplicación, y ya
# nos pasó una vez con el endurecimiento de systemd —la pantalla de bloqueo
# rechazaba la contraseña correcta—. En `complain` eso es imposible por
# construcción.
#
# Para pasarlo a enforce, se saca `flags=(complain)`. No antes de mirar el
# registro.
#
# ── Qué se le permite ───────────────────────────────────────────────────────
#
# Este proceso guarda todas las contraseñas de la sesión: es el backend de
# `org.freedesktop.secrets`. Lo que necesita es leer y escribir un archivo,
# atender D-Bus, y abrir su socket de desbloqueo en /run/user.

abi <abi/4.0>,

include <tunables/global>

profile vasak-keyring /usr/bin/vasak-keyring flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/dbus-session-strict>

  # ⚠ Acá NO van reglas `deny`. Se intentó y tumbó el escritorio.
  #
  # En AppArmor, `deny` se aplica **también en modo complain** —complain sólo
  # afecta a lo que el perfil no permite explícitamente, no a lo que prohíbe— y
  # encima es silenciosa: una denegación por `deny` no se audita salvo que se
  # escriba `audit deny`. O sea que rompe y no deja rastro.
  #
  # Con un `deny network,` acá, el llavero, el diálogo de polkit, el de
  # permisos, el de notificaciones y el lector de teclado no arrancaban: tokio
  # crea un socketpair AF_UNIX para manejar señales, `network` sin calificar
  # alcanza también a AF_UNIX, y el proceso moría con «failed to create
  # UnixStream: Permission denied» sin una sola línea de AppArmor en el diario.
  #
  # Un perfil en complain tiene que poder permitirlo todo. Las restricciones se
  # escriben al pasar a enforce, y ahí lo que sobra se prohíbe **no
  # permitiéndolo**, que es como funciona AppArmor: lo que el perfil no nombra,
  # no se puede. `deny` es para tapar algo que una abstracción incluida ya
  # permitió, y en ese caso conviene `audit deny` para que se vea.

  /usr/bin/vasak-keyring mr,

  # La base con los secretos. `k` es el bloqueo de archivo.
  owner @{HOME}/.local/share/vasak-keyring/ rw,
  owner @{HOME}/.local/share/vasak-keyring/** rwkl,

  # El socket por el que el módulo de PAM le pasa la contraseña del inicio de
  # sesión. Va en /run/user y no en XDG_RUNTIME_DIR: el módulo corre antes de
  # que esa variable exista.
  owner /run/user/@{uid}/vasak-keyring/ rw,
  owner /run/user/@{uid}/vasak-keyring/** rw,

  # El diálogo para desbloquear. Se intenta primero por systemd-run —para que
  # viva fuera de este cgroup— y si eso falla se lanza directo.
  #
  # Va `Ux` —sin confinar— y no `Px`, a propósito: el diálogo es una ventana
  # Tauri, y AppArmor tumba nuestras ventanas Tauri. Está medido: los tres
  # binarios que levantan el proceso web de WebKit acumularon 500, 262 y 250
  # volcados en un solo arranque, y pasa con el perfil más vacío posible en
  # complain, así que no es cuestión de escribir mejor las reglas. Ver
  # apparmor-borrador/README.md.
  #
  # Confinar el diálogo sería dejarte sin forma de desbloquear el llavero, que
  # es peor que no confinarlo. La `U` mayúscula limpia las variables de entorno
  # peligrosas —LD_PRELOAD y compañía— sin tocar las que el diálogo necesita
  # para dibujarse.
  /usr/bin/systemd-run rCx -> systemd_run,
  /usr/bin/vasak-keyring-prompt Ux,

  # Sitio para agregados locales sin tocar el paquete.
  include if exists <local/vasak-keyring>

  profile systemd_run {
    include <abstractions/base>
    include <abstractions/dbus-session-strict>
    /usr/bin/systemd-run mr,
    # Sin confinar, por lo mismo que arriba.
    /usr/bin/vasak-keyring-prompt Ux,
  }
}
