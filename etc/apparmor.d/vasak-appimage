# Perfil base para los AppImage: sin cámara ni micrófono por la vía directa.
#
# ── Qué confina, y qué no ───────────────────────────────────────────────────
#
# El perfil permite **todo** explícitamente y niega dos cosas. Suena raro en un
# perfil de seguridad, pero es la forma de escribir «no restrinjas nada de esta
# aplicación salvo exactamente esto»: en AppArmor una regla `deny` le gana a
# cualquier permiso.
#
# Es lo único mantenible acá. Un perfil completo para una aplicación que no
# escribimos nosotros es imposible de sostener: no sabemos qué archivos toca ni
# qué va a tocar tras actualizarse. Pero sí sabemos qué **no** queremos que
# haga.
#
# Va en enforce y no en complain, y eso se aprendió midiendo: en modo complain
# las reglas `deny` **no** se aplican. Se registran —el diario dice
# `apparmor="ALLOWED"` con el nombre del dispositivo— y se permiten igual. Un
# perfil como éste en complain no bloquea nada; sólo cuenta lo que habría
# bloqueado.
#
# Por eso están listadas todas las clases de regla que AppArmor media (`file`,
# `network`, `unix`, `dbus`, `mount`…): en enforce, lo que el perfil no nombra
# queda prohibido, y olvidarse una rompería la aplicación. Falta `rlimit` a
# propósito: esa clase sólo fija límites, no restringe.
#
# Las negaciones van con `audit` para que cada intento quede en el diario. Eso
# no es cosmético: es de donde va a salir el aviso «esta aplicación quiso usar
# la cámara, ¿se lo permitimos?».
#
# ── Por qué sólo la vía directa ─────────────────────────────────────────────
#
# En este sistema la cámara y el micrófono los reparte PipeWire: la cámara
# aparece como nodo v4l2 suyo, y una aplicación moderna nunca abre /dev/video0
# —le habla al socket de PipeWire—. Ese socket no se puede negar acá sin dejar
# a la aplicación además sin sonido, porque por el mismo socket va la
# reproducción.
#
# Lo que sí cierra este perfil es la vía de atrás: la aplicación que se saltea
# PipeWire y abre el dispositivo directamente. Hoy esa vía no tiene ningún
# control, así que el perfil es una mejora real aunque parcial.
#
# Cerrar la vía de PipeWire necesita otra pieza: un segundo socket con permisos
# restringidos —`sockets` en libpipewire-module-protocol-native y
# `access.socket` en libpipewire-module-access—, negando acá el normal y
# permitiendo el restringido. Eso queda pendiente porque un cliente restringido
# se queda esperando a que alguien le conceda permisos, y ese alguien todavía no
# existe.
#
# ── A qué se engancha ───────────────────────────────────────────────────────
#
# A los AppImage del directorio del usuario, que es el caso que la política de
# la distro marca como no verificado: pacman es lo oficial, el AppImage es lo
# adicional. Un binario en /usr/bin necesitó root para llegar ahí; un AppImage
# lo bajaste vos.

# ── Comprobado ──────────────────────────────────────────────────────────────
#
# Contra un AppImage de verdad (una aplicación Tauri empaquetada), con el perfil
# en enforce: arranca igual que sin perfil, queda etiquetado
# «vasak-appimage (enforce)» y no registra un solo bloqueo. O sea que la lista
# de clases de regla de abajo está completa — que es el riesgo de enforce.
#
# Y contra un AppImage de mentira que intenta abrir los dispositivos: cámara y
# micrófono dan «Permiso denegado» con `apparmor="DENIED"` en el diario, y los
# altavoces siguen accesibles.

abi <abi/4.0>,

include <tunables/global>

profile vasak-appimage @{HOME}/**/*.[aA]pp[iI]mage {
  # Todo permitido, explícitamente. Suena raro en un perfil de seguridad, pero
  # es la forma de escribir «no restrinjas nada salvo lo de abajo»: en AppArmor
  # una regla `deny` le gana a cualquier permiso, así que las dos negaciones
  # siguen valiendo.
  #
  # Y hace falta por dos razones concretas. Una, en enforce lo que no se nombra
  # queda prohibido, así que faltar una clase rompería la aplicación. Dos, el
  # parser aborta con un perfil que sólo tiene negaciones: se queda sin estados
  # que compilar.
  file,
  network,
  unix,
  signal,
  ptrace,
  dbus,
  capability,
  mount,
  umount,
  pivot_root,
  change_profile,
  io_uring,
  mqueue,
  # Sin esto no arrancan los que se aíslan a sí mismos —los de Electron, sobre
  # todo—, que montan su propio espacio de nombres.
  userns,

  # La cámara, por la vía directa.
  audit deny /dev/video* rwk,

  # El micrófono, por la vía directa. Sólo los dispositivos de **captura**: en
  # ALSA terminan en `c` (pcmC0D0c) y los de reproducción en `p`. Negar
  # /dev/snd/* entero dejaría a la aplicación muda, que no es lo que se decidió.
  audit deny /dev/snd/pcmC*D*c rwk,

  include if exists <local/vasak-appimage>
}
